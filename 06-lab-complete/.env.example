# Sao chép thành .env rồi chỉnh: cp .env.example .env  (file .env đã nằm trong .gitignore)
# KHÔNG ghi secret thật vào file này.
PORT=8000
ENVIRONMENT=development
# Đổi thành chuỗi ngẫu nhiên dài, ví dụ: python -c "import secrets; print(secrets.token_urlsafe(32))"
AGENT_API_KEY=change-me
REDIS_URL=redis://localhost:6379/0
RATE_LIMIT_PER_MINUTE=10
DAILY_BUDGET_USD=1.0
